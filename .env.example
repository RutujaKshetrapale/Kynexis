# ============================================================
# KYNEXIS Local Development Environment Configuration
# Copy this file to .env to override defaults
# ============================================================

# Database Configuration (MySQL 8.x)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_factory_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=21011017

# Security & Tokens
JWT_SECRET=SmartFactorySecretKeyForDevelopmentOnly123456789
INTERNAL_API_SECRET=KynexisInternalServiceCommunicationSecretKey2026

# Microservice URLs (Host Development Defaults)
AUTHENTICATION_SERVICE_URL=http://localhost:8081
PLANT_SERVICE_URL=http://localhost:8082
TELEMETRY_SERVICE_URL=http://localhost:8083
ALERT_SERVICE_URL=http://localhost:8084
MAINTENANCE_SERVICE_URL=http://localhost:8085
PRODUCTION_SERVICE_URL=http://localhost:8086
ENERGY_SERVICE_URL=http://localhost:8087
MACHINE_SERVICE_URL=http://localhost:8088
SENSOR_SERVICE_URL=http://localhost:8089

# Kafka Broker (Required for alert-service & telemetry-service)
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Docker Compose Overrides
MYSQL_HOST_PORT=3306
KAFKA_HOST_PORT=9092
