{
  "name": "kynexis",
  "version": "1.0.0",
  "private": true,
  "description": "Kynexis Smart Factory Platform - Microservices & Digital Twin",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node scripts/dev.js --backend-only",
    "dev:frontend": "node scripts/dev.js --frontend-only",
    "start": "node scripts/dev.js",
    "status": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-status.ps1",
    "stop": "node scripts/stop.js",
    "build": "npm run build --prefix Frontend"
  }
}
